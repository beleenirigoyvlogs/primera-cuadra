# ==============================================================================
# PRIMERA CUADRA · CONFIGURACIÓN DEL SIMULADOR PRIVADO / SHOWROOM
# ==============================================================================
#
# Dónde cargar estas variables en Vercel:
# 1. Ingresá a vercel.com y abrí el proyecto "primera-cuadra".
# 2. Andá a Settings -> Environment Variables.
# 3. Agregá cada una de las siguientes variables para los entornos (Production, Preview, Development).
# 4. Hacé un nuevo deploy para que tomen efecto.
#
# ------------------------------------------------------------------------------

# Usuario administrador para el ingreso
DEMO_USER=admin

# CONTRASEÑA - Opción A (RECOMENDADA): Hash criptográfico SHA-256 de la contraseña
# Para generar el hash de cualquier clave que elijas, ejecutá en tu terminal:
# node -e "console.log(require('crypto').createHash('sha256').update('TuClaveElegida').digest('hex'))"
#
# El hash por defecto para "PrimeraCuadra2026" es:
DEMO_PASS_HASH=289b74da3ae7e8293c74825ba079128db572e7197de7a31bc0bc1fe41a70135e

# CONTRASEÑA - Opción B (Alternativa en texto plano):
# Si preferís escribir la contraseña directa sin hash, descomentá la siguiente línea:
# DEMO_PASSWORD=PrimeraCuadra2026

# Secreto para firmar criptográficamente la cookie de sesión HTTP-only (HMAC-SHA256)
# Usá una cadena larga y aleatoria:
SESSION_SECRET=primera_cuadra_secure_showroom_session_salt_2026_super_secret_key
